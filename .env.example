# LAN OS secrets. You don't need to edit this: the setup page (http://localhost:8080/setup on the host PC)
# fills in a copy called ".env" for you. That file is never committed to Git and never shown on screen.
# Demo mode (Start LAN OS (demo).bat) works without any of these.

# Password for the admin page on other PCs. (On the host PC itself, the admin page always opens.)
ADMIN_PASSWORD=

# Optional. Steam Web API key: adds Away status, Join game for lobbies and the Shared Game Finder.
# Without it LAN OS reads public Steam profiles. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Client ID of the host's Spotify developer app, for LAN Radio. The setup page explains how to make one
# at https://developer.spotify.com/dashboard (no client secret needed).
SPOTIFY_CLIENT_ID=

# Optional. Discord bot token, for highlights on the wall. https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional. Anthropic API key, so Claude words the wall announcements. https://console.anthropic.com
AI_API_KEY=
