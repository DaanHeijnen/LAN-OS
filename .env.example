# LAN OS secrets. Copy this file, name the copy ".env" (in this same folder) and fill in the values.
# The .env file is never committed to Git and never shown on screen.
# Demo mode (npm run demo) works without any of these.

# Steam Web API key, so LAN OS can see who is playing what.
# Get it at https://steamcommunity.com/dev/apikey (sign in with the host's Steam account; any domain name works, e.g. "lan-os.local").
STEAM_API_KEY=

# Password for the admin page, for when no admin player is signed in on this browser.
# Choose any password and share it only with the admins.
ADMIN_PASSWORD=

# --- Later milestones (leave empty for now) ---

# Spotify app for LAN Radio (Milestone 2). Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Discord bot token for the highlight preview (Milestone 6). https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=

# AI key for announcement lines (Milestone 4).
# AI_API_KEY=
