{
  "name": "lan-os",
  "private": true,
  "type": "module",
  "description": "LAN OS: a local web app for a LAN weekend. Projector wall, player dashboards and admin page.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/src/main.ts",
    "demo": "node apps/server/src/main.ts --demo",
    "build": "npm run build -w @lan-os/web",
    "dev:web": "npm run dev -w @lan-os/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
