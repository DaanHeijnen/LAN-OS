{
  "name": "lan-os",
  "private": true,
  "type": "module",
  "description": "LAN OS: a local web app for a LAN weekend. Projector wall, player dashboards and admin page.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/src/main.ts",
    "demo": "node apps/server/src/main.ts --demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vitest": "3.2"
  }
}
